{
  "env": {
    "ANTHROPIC_BASE_URL": "https://adesso-ai-hub.3asabc.de",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tee:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(git:*)",
      "Bash(cd:*)",
      "Bash(dir:*)",
      "Bash(mkdir:*)",
      "Bash(awk:*)",
      "Bash(xargs:*)",
      "Bash(./mvnw:*)",
      "Bash(./mvnw.cmd:*)",
      "Bash(mvn:*)",
      "Bash(mvnw:*)",
      "Bash(mvnw.cmd:*)",
      "Bash(./gradlew:*)",
      "Bash(./gradlew.bat:*)",
      "Bash(java:*)",
      "Bash(javap:*)",
      "Bash(javac:*)",
      "Bash(openspec:*)",
      "WebSearch",
      "mcp__GitLab__get_merge_request",
      "mcp__GitLab__get_merge_request_commits",
      "mcp__GitLab__get_merge_request_diffs",
      "mcp__GitLab__get_workitem_notes"
    ]
  },
  "model": "opusplan",
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "autoApprove": true,
  "theme": "light"
}
